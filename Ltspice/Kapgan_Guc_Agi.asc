TEXT 0 1000 Left 3 ;1) GIRIS-1: DB25 (J2) harici 5V / BEC  ->  F1 (2A PTC)  ->  5V1  ->  D2 (SS34)  ->  +5V
TEXT 0 1048 Left 2 ;BEC kaynagi + kablo + konnektor modeli; 5V1 dogrudan RPi Zero 2W'yi (J1) besler. D2/D3 = diyot-VEYA.
TEXT -16 1312 Left 1 ;BEC (EXT_ON ile ac/kapa)
TEXT 1264 1296 Left 1 ;TVS SMAJ6.0A
TEXT 1416 1296 Left 1 ;elektrolitik
TEXT 0 1520 Left 3 ;2) GIRIS-2: USB-C (J4) VBUS  ->  F2 (1A PTC)  ->  D3 (SS34)  ->  +5V
TEXT 0 1568 Left 2 ;USB host portu + kablo enduktansi (sicak takma ani akimi). U9 USBLC6 VBUS kenetlemesi, D11 amber VBUS LED'i.
TEXT -16 1832 Left 1 ;USB host (USB_ON)
TEXT 1328 1816 Left 1 ;U9 USBLC6 VBUS-GND
TEXT 1544 1896 Left 1 ;VBUS LED
TEXT 0 2040 Left 3 ;3) +5V RAYI: LED, buzzer (J3, Q1 AO3400A, D7 flyback), U1 LD39150DT33 LDO  ->  3V3_DIGI
TEXT 0 2088 Left 2 ;LDO alt devresi kutu icindeki XU1 satiri ile cagrilir (pinler: IN=V5, OUT=V3V3, GND=0).
TEXT 464 2416 Left 1 ;+5V LED
TEXT 592 2512 Left 1 ;MCU PC13 (BUZZER) -> R5 -> Q1 kapisi (2.7 kHz)
TEXT 1416 2256 Left 1 ;J3 buzzer (2mH/80R)
TEXT 1792 2168 Left 2 ;U1  LD39150DT33
TEXT 1792 2200 Left 1 ;1.5A ULDO (DPAK)
TEXT 1792 2272 Left 2 !XU1 V5 V3V3 0 LD39150_33
TEXT 1784 2224 Left 1 ;IN
TEXT 2096 2224 Left 1 ;OUT
TEXT 1976 2368 Left 1 ;GND
TEXT 0 2600 Left 3 ;4) RPi ZERO 2W (J1, 5V1 rayindan) + PI_3V3 (Pi'nin kendi 3V3 cikisi)
TEXT 0 2648 Left 2 ;Sabit-guc yuk: P/V, PMIC UVLO ~4.0V. Profil = VP_PI_BASE (W) + VP_PI_WIFI (W).
TEXT 448 2912 Left 1 ;Pi PMIC 3V3 (V5V1'e bagli)
TEXT 0 3120 Left 3 ;5) 3V3_DIGI: STM32F405 (U2) VDD dekuplaji, MCU akimi, LED'ler
TEXT 0 3168 Left 2 ;B_MCU = MCU cekirdek+cevre akimi (profil VP_MCU + flash yazma VP_MCUFL), D9 mavi LED MCU pini (PB4) ile surulur.
TEXT 1648 3576 Left 1 ;MCU_LED (GPIO)
TEXT 1808 3496 Left 1 ;3V3 LED
TEXT 0 3680 Left 3 ;6) 3V3_DIGI: CAN (SN65HVD230), I2C pull-up'lar, sensor VDDIO'lari, lojik, ariza senaryosu
TEXT 0 4200 Left 3 ;7) FERRIT FILTRELI KOLLAR (BLM18EG601SN1D): VDDA, BMI270, MPU-6500, BMP280, microSD
TEXT 64 4288 Left 2 ;STM32 VDDA
TEXT 1056 4288 Left 2 ;BMI270 VDD (U5)
TEXT 2528 4288 Left 2 ;MPU-6500 VDD (U4)
TEXT 64 4768 Left 2 ;BMP280 (U3)
TEXT 1568 4768 Left 2 ;microSD (J5)
TEXT 1984 5040 Left 1 ;SD yazma: 200us 150mA tepe, 90mA mesgul, 20ms periyot
TEXT 0 -160 Left 4 ;KAPGAN FCU - GUC AGI SIMULASYONU  (kocapilot Kapgan.kicad_sch + Kapgan.kicad_sch, rev1.0)
TEXT 0 -80 Left 2 ;Tum modeller dosyaya gomulu (alt kisimda). Yukler = ters yonlu akim kaynaklari (B-I). Tum dosya ASCII.
TEXT 24 24 Left 3 ;NE OGRENMEK ISTIYORSAN -> NASIL ELDE EDERSIN  (Run'dan sonra; .meas sonuclari: View > SPICE Error Log  [Ctrl+L])
TEXT 24 96 Left 2 ;  Ray gerilimi (3V3, +5V, 5V1, SD...)  : rayin teline tikla  ->  V(V3V3), V(V5), V(V5V1), V(V3V3_SD), V(V3V3_VDDA)...
TEXT 24 136 Left 2 ;  Ray min/max/ortalama, LDO payi       : Ctrl+L -> V3V3_MIN, V3V3_MAX, V3V3_AVG, V5_MIN, LDO_HEADROOM_MIN, VSD_MIN, VDDA_PP
TEXT 24 176 Left 2 ;  Bir elemanin akimi                   : eleman govdesine tikla (akim probu)  ->  I(C9), I(R43), I(L_BUZ) ...
TEXT 24 216 Left 2 ;  Bir elemanin harcadigi guc           : Alt + eleman govdesine tikla
TEXT 24 256 Left 2 ;  Kaynaktan cekilen akim / tepe        : I(V_EXT), I(V_USB) (negatif = kaynaktan cikan); Ctrl+L -> I_EXT_PK, I_USB_PK, I_*_AVG
TEXT 24 296 Left 2 ;  LDO cikis akimi / jonksiyon sicakligi: V(XU1:ip) [1V = 1A],  V(XU1:tj) [1V = 1 C];  Ctrl+L -> I_LDO_PK, I_LDO_AVG, TJ_LDO
TEXT 24 336 Left 2 ;  PTC sigorta sicakligi                : V(XF1:X1:t), V(XF2:X1:t) [C];  ~125 C'de acar.  Ctrl+L -> T_F1, T_F2
TEXT 24 376 Left 2 ;  Bir dalga formunun ortalama/RMS'i     : plot penceresinde iz adina Ctrl + sol tik
TEXT 24 416 Left 2 ;  Dalgalanma spektrumu (FFT)            : plot penceresinde sag tik > View > FFT
TEXT 24 456 Left 2 ;  Sicaklik taramasi                     : asagidaki ';.step param TAMB ...' satirinda ';' yerine '!' yaz
TEXT 24 496 Left 2 ;  Sadece USB / sadece BEC               : .param satirinda EXT_ON=0 veya USB_ON=0
TEXT 24 536 Left 2 ;  3V3 kisa devre / ariza testi          : IFAULT=1.5 (125 ms'de 5 ms boyunca 1.5 A)
TEXT 24 576 Left 2 ;  Yuk profilini degistirmek             : VP_* kaynaklarinin degeri = yuk akimi [A] (RPi icin guc [W])
TEXT 24 616 Left 2 ;  Kondansator DC-bias / ESR             : deger {100n*K100N} -> K... carpani .param'da; ESR/ESL sag tik > SpiceLine (Rser/Lser)
TEXT 24 656 Left 2 ;  Uzun termal analiz (PTC/LDO isinmasi) : .tran 0 30 0 1m  (birkac dakika surer)
TEXT 24 696 Left 2 ;Ag isimleri: VEXT_SRC/EXT1/VIN_DB25 = BEC tarafi, V5V1 = 5V1, VBUS/VBUS_F = USB, V5 = +5V, V3V3 = 3.3V_DIGI, PROF_* = yuk profili sinyalleri (devre degil).
TEXT 24 736 Left 2 ;Eleman adlari KiCad referanslaridir (rev1.0, 2026-10-23). V_/R_BEC/L_*CBL/B_*/VP_* = semada olmayan kaynak, kablo ve yuk modelleri.
TEXT 0 5304 Left 3 ;SIMULASYON AYARLARI
TEXT 0 5368 Left 2 !.param TAMB=25 EXT_ON=1 USB_ON=1 VEXT=5.2 VUSB=5.0 RBEC=30m RUSB=0.25 IFAULT=0 K100N=0.95 K1U=0.85 K4U7=0.55 K10U5=0.45 K10U3=0.62 RFB=0.25
TEXT 0 5416 Left 1 ;TAMB=25 : ortam sicakligi [C]
TEXT 1400 5416 Left 1 ;EXT_ON=1 : DB25 (BEC) 5V girisi: 1=var 0=yok
TEXT 2800 5416 Left 1 ;USB_ON=1 : USB-C VBUS: 1=var 0=yok
TEXT 0 5448 Left 1 ;VEXT=5.2 : BEC cikis gerilimi [V]
TEXT 1400 5448 Left 1 ;VUSB=5.0 : USB host gerilimi [V]
TEXT 2800 5448 Left 1 ;RBEC=30m : BEC cikis direnci [Ohm]
TEXT 0 5480 Left 1 ;RUSB=0.25 : USB port + 1m kablo direnci [Ohm]
TEXT 1400 5480 Left 1 ;IFAULT=0 : 3V3 ariza akimi (125ms'de 5ms) [A]
TEXT 2800 5480 Left 1 ;K100N=0.95 : 100nF X7R DC-bias carpani
TEXT 0 5512 Left 1 ;K1U=0.85 : 1uF X5R @3.3V carpani
TEXT 1400 5512 Left 1 ;K4U7=0.55 : 4.7uF X5R @5V carpani
TEXT 2800 5512 Left 1 ;K10U5=0.45 : 10uF X5R @5V carpani
TEXT 0 5544 Left 1 ;K10U3=0.62 : 10uF X5R @3.3V carpani
TEXT 1400 5544 Left 1 ;RFB=0.25 : BLM18EG601SN1D DCR [Ohm]
TEXT 0 5608 Left 2 !.tran 0 150m 0 2u
TEXT 0 5648 Left 2 ;.step param TAMB list -40 25 85     <- sicaklik taramasi: bastaki ';' yerine '!' yaz
TEXT 0 5688 Left 2 ;.step param EXT_ON list 0 1         <- sadece-USB / harici giris karsilastirmasi
TEXT 0 5744 Left 3 ;OLCUMLER (.meas) - sonuclar Ctrl+L
TEXT 0 5808 Left 2 !.meas TRAN V3V3_MIN MIN V(V3V3) FROM 20m TO 150m\n.meas TRAN V3V3_MAX MAX V(V3V3) FROM 20m TO 150m\n.meas TRAN V3V3_AVG AVG V(V3V3) FROM 20m TO 150m\n.meas TRAN VSD_MIN MIN V(V3V3_SD) FROM 20m TO 150m\n.meas TRAN VDDA_PP PP V(V3V3_VDDA) FROM 20m TO 150m\n.meas TRAN V5_MIN MIN V(V5) FROM 20m TO 150m\n.meas TRAN V5V1_MIN MIN V(V5V1) FROM 20m TO 150m\n.meas TRAN LDO_HEADROOM_MIN MIN V(V5)-V(V3V3) FROM 20m TO 150m\n.meas TRAN I_LDO_PK MAX V(XU1:ip) FROM 20m TO 150m\n.meas TRAN I_LDO_AVG AVG V(XU1:ip) FROM 20m TO 150m\n.meas TRAN TJ_LDO MAX V(XU1:tj)\n.meas TRAN I_EXT_PK MAX -I(V_EXT) FROM 5m TO 150m\n.meas TRAN I_USB_PK MAX -I(V_USB) FROM 2m TO 150m\n.meas TRAN I_USB_AVG AVG -I(V_USB) FROM 20m TO 150m\n.meas TRAN I_EXT_AVG AVG -I(V_EXT) FROM 20m TO 150m\n.meas TRAN T_F1 MAX V(XF1:X1:t)\n.meas TRAN T_F2 MAX V(XF2:X1:t)\n.meas TRAN VBUZ_PK MAX V(BUZ_D) FROM 40m TO 125m
TEXT 0 6416 Left 3 ;MODEL KUTUPHANESI (gomulu) - LD39150, PTC, SS34, TVS, LED, AO3400A, fonksiyonlar
TEXT 0 6480 Left 2 !*======================================================================\n* KAPGAN FCU - GUC AGI MODEL KUTUPHANESI (LTspice'a gomulu)\n*======================================================================\n* Ortak global parametre: TAMB (ortam sicakligi, C). Tum termal\n* modeller ve diyot/LED/MOSFET instance sicakliklari TAMB'a baglidir.\n*\n* --- LD39150DT33 : 1.5A ULDO, BiCMOS, DPAK ---------------------------\n* Datasheet (ST DocID13159): Vdrop 200mV@1.5A / 40mV@300mA (typ),\n* 400mV max (-40..125C); Iq 1mA typ, 2.5mA max; Isc 3A;\n* line reg 0.04% (VO+1..6V); load reg 0.06%/A typ; SVR 65dB@120Hz;\n* TSD 170C, histerezis 10C; Rth j-c 8C/W.\n* Model: termal Foster agi (Tj dugumu), Tj'ye bagli Ron/Vref/Ilim/Iq,\n* PI hata yukselteci + anti-windup, gecis elemani kutbu, UVLO, soft-start,\n* termal kapanma (histerezisli), PMOS govde diyotu (OUT->IN ters akim).\n.subckt LD39150_33 IN OUT GND params: VNOM=3.3 RON25=0.133 ISC=3.0 IQ0=1m\n+ RJC=8 CJC=0.03 RCA=50 CCA=1.2 TSD=170 TSDH=10 UVLO=2.25 TSS=150u\n+ GM=30 FI=3k GDC=505 FP=1Meg KLINE=2.35e-4 TC1=20u TC2=-0.6u\n* -- termal (V(tj) = jonksiyon sicakligi, C)\nBamb amb 0 V={TAMB}\nRjc tj tc {RJC}\nCjc tj tc {CJC}\nRca tc amb {RCA}\nCca tc amb {CCA}\nBpd 0 tj I=max(V(IN,OUT),0)*V(ip)+max(V(IN,GND),0)*V(ig)\n* -- termal kapanma (histerezisli Schmitt)\nBtsd ts0 0 V=0.5*(1+tanh((V(tj)-({TSD}-{TSDH}*V(tsd)))/0.5))\nRts ts0 tsd 1k\nCts tsd 0 1n\n* -- UVLO (100mV histerezis) ve etkinlestirme\nBen en0 0 V=0.5*(1+tanh((V(IN,GND)-({UVLO}-0.1*V(en)))/0.02))*(1-V(tsd))\nRen en0 en 1k\nCen en 0 1n\n* -- referans: sicaklik egrisi + hat regulasyonu + soft-start\nBvt vt 0 V={VNOM}*(1+{TC1}*(V(tj)-25)+{TC2}*(V(tj)-25)*(V(tj)-25))*(1+{KLINE}*(V(IN,GND)-4.3))*V(en)+V(GND)\nRss vt vr 1k\nCss vr 0 {TSS/1k}\n* -- PI hata yukselteci (A/V), anti-windup, sizinti -> sonlu DC kazanc (yuk reg.)\nBerr err 0 V=V(vr)-V(OUT)\nBint 0 vi I=1u*({GM}*6.2832*{FI}*V(err)-1e6*(V(raw)-V(isat))-V(vi)*6.2832*{FI}/({GDC}/{GM}-1)-(1-V(en))*1e6*V(vi))\nCint vi 0 1u\nBraw raw 0 V={GM}*V(err)+V(vi)\nBsat isat 0 V=max(min(V(raw),{ISC}*(1-0.002*(V(tj)-25))),0)*V(en)\nRgp isat ig1 1k\nCgp ig1 0 {1/(6.2832*FP*1k)}\n* -- gecis elemani: dropout bolgesinde Ron(Tj), regulasyonda akim kaynagi\nBip 0 ip I=(0.5*(V(IN,OUT)+sqrt(V(IN,OUT)*V(IN,OUT)+1e-6)))/({RON25}*(1+0.004*(V(tj)-25)))*tanh(max(V(ig1),0)*{RON25}*(1+0.004*(V(tj)-25))/(0.5*(V(IN,OUT)+sqrt(V(IN,OUT)*V(IN,OUT)+1e-6))+1m))\nRip ip 0 1\nCip ip 0 1n\nBpass IN OUT I=V(ip)\nDbody OUT IN DBODY_LD\n.model DBODY_LD D(IS=1e-11 N=1.1 RS=0.05 CJO=200p)\n* -- toprak (quiescent) akimi: Iq(Tj) + dropout'ta artis\nBig ig 0 V=1u+V(en)*({IQ0}*(1+0.003*(V(tj)-25))+0.8m*0.5*(1+tanh((0.05-V(IN,OUT)+V(ip)*{RON25})/0.02)))\nBgnd IN GND I=V(ig)\nCini IN GND 100p\nCouti OUT GND 50p\nRbl OUT GND 2Meg\n.ends LD39150_33\n*\n* --- POLIMER PTC (elektro-termal, latching) ---------------------------\n* R(T)=R0*(1+TCR*(T-25))*(1+KJ/(1+exp(-(T-TTRIP)/2.5)))\n* I^2R isinmasi -> RTH/CTH -> T ; TTRIP civarinda 4 dekad sicrama.\n.subckt PTC_POLY A B params: R0=0.1 RTH=195 CTH=9m TTRIP=125 KJ=1e4 TCR=0.008\nBamb amb 0 V={TAMB}\nBr A B I=V(A,B)/({R0}*(1+{TCR}*(V(t)-25))*(1+{KJ}/(1+exp(-(V(t)-{TTRIP})/2.5))))\nBp 0 t I=V(A,B)*V(A,B)/({R0}*(1+{TCR}*(V(t)-25))*(1+{KJ}/(1+exp(-(V(t)-{TTRIP})/2.5))))\nRth t amb {RTH}\nCth t amb {CTH}\n.ends PTC_POLY\n* F1: 1206 1.1A-hold sinifi (MF-MSMF110 benzeri) ; F2: 2920 2A-hold sinifi\n.subckt PTC_1206_1A1 A B\nX1 A B PTC_POLY R0=0.10 RTH=195 CTH=9m\n.ends PTC_1206_1A1\n.subckt PTC_2920_2A A B\nX1 A B PTC_POLY R0=0.045 RTH=111 CTH=0.15\n.ends PTC_2920_2A\n*\n* --- SS34 Schottky (40V/3A, SMA) ELEKTRO-TERMAL -----------------------\n* Vf: ~0.31V@0.1A, 0.41V@1A, 0.50V@3A (25C); Ir: ~5uA@40V/25C,\n* ~2mA@100C; Eg=0.69 (Schottky), XTI=2; oz isinma Rth(j-a)=85C/W.\n.subckt SS34_ET A K params: IS0=5u N=1.2 RS=0.03 XTI=2 EG=0.69 BV=46 IBV=0.5m RTH=85 CTH=0.05 CJ=250p\nBamb amb 0 V={TAMB}\nRrs A ja {RS}\nBd ja K I={IS0}*exp({XTI}/{N}*ln((V(t)+273.15)/298.15)+{EG}/({N}*8.617e-5*(V(t)+273.15))*((V(t)+273.15)/298.15-1))*(exp(min(V(ja,K)/({N}*8.617e-5*(V(t)+273.15)),40))*(1+max(V(ja,K)/({N}*8.617e-5*(V(t)+273.15))-40,0))-1)-{IBV}*exp(min((-V(ja,K)-{BV})/(1.5*8.617e-5*(V(t)+273.15)),40))\nCj ja K {CJ}\nBp 0 t I=max(V(A,K)*V(A,ja)/{RS},0)\nRth t amb {RTH}\nCth t amb {CTH}\n.ends SS34_ET\n*\n* --- TVS / ESD diyotlari ---------------------------------------------\n* SMAJ6.0A: VR=6.0V, VBR 6.67..7.37V@10mA, VC=10.3V@38.8A, alpha(VBR)~5.7e-4/C\n.model SMAJ6V0A D(IS=2e-12 N=1.1 RS=0.012 BV=6.95 IBV=10m NBV=1.4 TBV1=5.7e-4 CJO=3.2n VJ=0.8 M=0.4 TT=50n EG=1.11 XTI=3)\n* USBLC6-2SC6 VBUS-GND zener yolu: VBR~6.1V, sizinti <150nA@5V\n.model USBLC6_Z D(IS=1e-14 N=1.05 RS=0.5 BV=6.1 IBV=1m NBV=1.2 TBV1=6e-4 CJO=60p)\n*\n* --- LED'ler (0603, tipik egriler; tempco ~-2..-3mV/C) ---------------\n.model LED_BLUE  D(IS=1.3e-21 N=2.595 RS=8 EG=1.38 XTI=3 CJO=40p BV=5 IBV=10u)\n.model LED_GREEN D(IS=2.34e-21 N=1.769 RS=6 EG=1.36 XTI=3 CJO=30p BV=5 IBV=10u)\n.model LED_RED   D(IS=2.22e-18 N=2.012 RS=5 EG=1.14 XTI=3 CJO=30p BV=5 IBV=10u)\n.model LED_AMBER D(IS=8.43e-19 N=2.012 RS=5 EG=1.14 XTI=3 CJO=30p BV=5 IBV=10u)\n*\n* --- AO3400A N-MOSFET (30V, 28mOhm@4.5V, Vth~1.05V, Ciss~630p) -------\n.model AO3400A VDMOS(Rg=1.5 Vto=1.05 Kp=19 Lambda=0.02 Rd=8m Rs=5m Rb=12m Cgdmax=200p Cgdmin=30p Cgs=550p Cjo=110p M=0.5 Is=2e-12 N=1.1 BV=30 Ksubthres=0.1 Bex=-1.5 Vtotc=-3m mfg=AOS Vds=30 Ron=28m Qg=7n)\n*\n* --- MCU GPIO cikis kati (yuksek-taraf ~40 Ohm, yumusak gecis) --------\n.model SW_GPIO SW(Ron=40 Roff=100Meg Vt=1.65 Vh=-0.3)\n*\n* --- yuk davranis fonksiyonlari --------------------------------------\n* CMOS dijital yuk: akim ~ V (C*V*f), POR esigi altinda ~0\n.func fcmos(v,von) {max(v,0)/3.3*0.5*(1+tanh((v-von)/0.08))}\n* SMPS/PMIC girisi: sabit guc, UVLO altinda kapali\n.func fpsu(p,v,vuv) {p/max(v,3.5)*0.5*(1+tanh((v-vuv)/0.05))}
RECTANGLE Normal 1776 2136 2160 2392 2
RECTANGLE Normal 0 0 4200 808 2
