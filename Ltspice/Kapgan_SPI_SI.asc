TEXT 0 -160 Left 4 ;KAPGAN FCU - SPI1/SPI2/SPI3 SINYAL BUTUNLUGU + STM32 GUC (SSO)  (kocapilot Kapgan.kicad_sch rev1.0)
TEXT 0 -80 Left 2 ;IO tamponlari IBIS-benzeri davranissal modeldir (RON/ISAT, kenar, paket RLC, ESD, esikler, sicaklik/proses). Modeller dosyaya gomulu.
TEXT 24 24 Left 3 ;NE OGRENMEK ISTIYORSAN -> NASIL ELDE EDERSIN  (Run'dan sonra; .meas sonuclari: View > SPICE Error Log  [Ctrl+L])
TEXT 24 96 Left 2 ;  Ag adlari: L_* = lojik uyaran (0/1 V), *_M = STM32 pini, *_D = cihaz (sensor/SD) pini, *_R/_W = seri direnc sonrasi, R_* = alicinin lojik ciktisi (0/1 V)
TEXT 24 136 Left 2 ;  Cihaz pinindeki saat kenari / zil      : V(S1_SCK_D), V(S2_SCK_D), V(S3_SCK_D)  (MOSI, CS icin ayni: S1_MOSI_D ...)
TEXT 24 176 Left 2 ;  Asim / alt-asim (overshoot)            : Ctrl+L -> S1_SCK_D_MAX (>3.3V asim), S1_SCK_D_MIN (<0V alt-asim) ...  (tum hatlar icin var)
TEXT 24 216 Left 2 ;  MISO dogru okundu mu?                  : Ctrl+L -> S1_MISO_B05_EXP1 = ornekleme anindaki V(S1_MISO_M); EXP1 ise >2.0V, EXP0 ise <0.8V olmali
TEXT 24 256 Left 2 ;  MISO kurulma (setup) payi              : V(S1_MISO_M) ile V(S1_SCK_M)'yi ayni grafikte ac; ornekleme kenari ile MISO'nun esigi gecmesi arasi - 5 ns
TEXT 24 296 Left 2 ;  Lojik gecikme (tampon+iz)              : V(L_S1_SCK) (uyaran) ile V(R_S1_SCK) (cihazin gordugu lojik) arasi; kursor: grafikte iz adina tikla
TEXT 24 336 Left 2 ;  Yukselme/dusme suresi                  : V(S1_SCK_D) uzerinde iki kursor (%10 = 0.33V, %90 = 2.97V)
TEXT 24 376 Left 2 ;  Toprak sicramasi / SSO                 : V(VSSD) ve V(VDDD,VSSD);  Ctrl+L -> VSSD_PP, VDDD_MIN
TEXT 24 416 Left 2 ;  Besleme dalgalanmasi                   : Ctrl+L -> V3V3_PP, VSD_PP ;  V(V3V3), V(V3V3_SD)
TEXT 24 456 Left 2 ;  Bir hattin anlik akimi                 : seri direnc govdesine tikla -> I(RT_S1_SCK) (SPI1/2), I(R24) / I(R13) (SPI3)
TEXT 24 496 Left 2 ;  Hizli-soguk / yavas-sicak kose         : .param KPROC=1.3 TAMB=-40  /  KPROC=0.75 TAMB=85   (tipik: 1 / 25)
TEXT 24 536 Left 2 ;  33 Ohm seri direnc denemesi (SPI1/2)   : .param RS12=33  (RT_* direncleri semada YOK, yalnizca deneme icin; 1m = yok sayilir)
TEXT 24 576 Left 2 ;  Iz uzunlugu degistirme                 : LEN1/LEN2/LEN3 [m] (layout olmadigi icin varsayim: 25/35/45 mm)
TEXT 24 616 Left 2 ;  Sensor cikis gecikmesi                 : TDO_* paramlari bilgi amaclidir; uyaranlar uretilirken sabitlenmistir (BMI 40ns, MPU 20ns, SD 14ns)
TEXT 24 656 Left 2 ;Eleman adlari KiCad referanslaridir (rev1.0). opamp2 sembolleri = IO tamponlari: U2_PA5 = STM32 PA5 pini, U5_SCX = BMI270 SCX pini, J5_CLK = SD CLK ...
TEXT 0 888 Left 3 ;A) GUC: +5V (sabit) -> U1 LD39150DT33 -> 3V3_DIGI ; STM32F405 (U2) dekuplaj + cekirdek (XCORE) ; sensor/SD beslemeleri
TEXT 0 936 Left 2 ;VDDD/VSSD = STM32 kalip ici besleme/toprak (paket L/R sonrasi). Tum STM32 IO tamponlari bu dugumlerden beslenir -> SSO / toprak sicramasi.
TEXT 640 1048 Left 2 ;U1 LD39150DT33
TEXT 632 1096 Left 1 ;IN
TEXT 888 1096 Left 1 ;OUT
TEXT 640 1160 Left 2 !XU1 V5 V3V3 0 LD39150_33
TEXT 2896 1048 Left 2 ;U2 STM32F405RGT6 - besleme/cekirdek modeli
TEXT 2896 1080 Left 1 ;paket L/R, kalip dekuplaji, 1.2V reg., 168 MHz akim darbeleri
TEXT 2896 1176 Left 2 !XCORE V3V3 0 VCAP1 VCAP2 VDDD VSSD STM32F405_CORE
TEXT 2888 1104 Left 1 ;VDD
TEXT 2968 1312 Left 1 ;VSS
TEXT 3112 1312 Left 1 ;VCAP_1
TEXT 3288 1312 Left 1 ;VCAP_2
TEXT 3368 1104 Left 1 ;VDDD
TEXT 3368 1136 Left 1 ;VSSD
TEXT 0 1608 Left 3 ;B) SPI1: STM32 PA5/PA7/PA6/PA4  <->  BMI270 (U5)   mod 3, 10.5 MHz
TEXT 0 1656 Left 2 ;soldan saga: lojik uyaran -> surucu tampon (opamp2 sembolu) -> [seri R] -> PCB izi (LTRA-benzeri RLC) -> [pull-up] -> alici tampon -> lojik cikis
TEXT 0 1816 Left 2 ;SCK :  STM32 PA5  ->  BMI270 SCX
TEXT 0 2168 Left 2 ;MOSI :  STM32 PA7  ->  BMI270 SDX
TEXT 0 2520 Left 2 ;CS :  STM32 PA4  ->  BMI270 CSB
TEXT 0 2872 Left 2 ;MISO :  BMI270 SDO  ->  STM32 PA6   (OE = cihaz cikis etkin)
TEXT 2432 2872 Left 1 ;cihaz SDO cikis-etkin uyarani
TEXT 0 3320 Left 3 ;C) SPI2: STM32 PB13/PB15/PB14/PB12  <->  MPU-6500 (U4)   mod 3, 10.5 MHz
TEXT 0 3368 Left 2 ;soldan saga: lojik uyaran -> surucu tampon (opamp2 sembolu) -> [seri R] -> PCB izi (LTRA-benzeri RLC) -> [pull-up] -> alici tampon -> lojik cikis
TEXT 0 3528 Left 2 ;SCK :  STM32 PB13  ->  MPU6500 SCLK
TEXT 0 3880 Left 2 ;MOSI :  STM32 PB15  ->  MPU6500 SDI
TEXT 0 4232 Left 2 ;CS :  STM32 PB12  ->  MPU6500 nCS
TEXT 0 4584 Left 2 ;MISO :  MPU6500 SDO  ->  STM32 PB14   (OE = cihaz cikis etkin)
TEXT 2432 4584 Left 1 ;cihaz SDO cikis-etkin uyarani
TEXT 0 5032 Left 3 ;D) SPI3: STM32 PC10/PC12/PC11/PC2  <->  microSD (J5)   mod 0, 21.0 MHz
TEXT 0 5080 Left 2 ;soldan saga: lojik uyaran -> surucu tampon (opamp2 sembolu) -> [seri R] -> PCB izi (LTRA-benzeri RLC) -> [pull-up] -> alici tampon -> lojik cikis
TEXT 0 5240 Left 2 ;SCK :  STM32 PC10  ->  SD CLK
TEXT 0 5592 Left 2 ;MOSI :  STM32 PC12  ->  SD CMD
TEXT 0 5944 Left 2 ;CS :  STM32 PC2  ->  SD DAT3
TEXT 0 6296 Left 2 ;MISO :  SD DAT0  ->  STM32 PC11   (OE = cihaz cikis etkin)
TEXT 2416 6296 Left 1 ;cihaz SDO cikis-etkin uyarani
TEXT 0 6840 Left 3 ;SIMULASYON AYARLARI
TEXT 0 6904 Left 2 !.param TAMB=25 KPROC=1 VPLUS5=4.8 LEN1=0.025 LEN2=0.035 LEN3=0.045 ZL=330n ZC=132p ZR=2.5 TDO_BMI=40n TDO_MPU=20n TDO_SD=14n K100N=0.95 K1U=0.85 K4U7=0.55 K10U5=0.45 K10U3=0.62 K2U2=0.95 RFB=0.25 RS12=1m
TEXT 0 6952 Left 1 ;TAMB=25 : ortam/kalip sicakligi [C]
TEXT 1400 6952 Left 1 ;KPROC=1 : IO surucu proses koseesi: 0.75 yavas / 1 tipik / 1.3 hizli
TEXT 2800 6952 Left 1 ;VPLUS5=4.8 : LDO girisi (+5V, diyot-VEYA sonrasi) [V]
TEXT 0 6984 Left 1 ;LEN1=0.025 : SPI1 (MCU-BMI270) iz uzunlugu [m]
TEXT 1400 6984 Left 1 ;LEN2=0.035 : SPI2 (MCU-MPU6500) iz uzunlugu [m]
TEXT 2800 6984 Left 1 ;LEN3=0.045 : SPI3 (MCU-microSD) iz uzunlugu [m]
TEXT 0 7016 Left 1 ;ZL=330n : iz enduktansi [H/m] (Z0~50 Ohm mikroserit)
TEXT 1400 7016 Left 1 ;ZC=132p : iz kapasitesi [F/m] (~6.6 ns/m)
TEXT 2800 7016 Left 1 ;ZR=2.5 : iz direnci [Ohm/m] (0.2mm, 35um Cu)
TEXT 0 7048 Left 1 ;TDO_BMI=40n : BMI270 SDO cikis gecikmesi (SCK dususunden) [s]
TEXT 1400 7048 Left 1 ;TDO_MPU=20n : MPU-6500 SDO cikis gecikmesi [s]
TEXT 2800 7048 Left 1 ;TDO_SD=14n : microSD (SPI modu) cikis gecikmesi tODLY [s]
TEXT 0 7080 Left 1 ;K100N=0.95 : 100nF DC-bias
TEXT 1400 7080 Left 1 ;K1U=0.85 : 1uF DC-bias
TEXT 2800 7080 Left 1 ;K4U7=0.55 : 4.7uF@5V DC-bias
TEXT 0 7112 Left 1 ;K10U5=0.45 : 10uF@5V DC-bias
TEXT 1400 7112 Left 1 ;K10U3=0.62 : 10uF@3.3V DC-bias
TEXT 2800 7112 Left 1 ;K2U2=0.95 : VCAP 2.2uF@1.2V DC-bias
TEXT 0 7144 Left 1 ;RFB=0.25 : BLM18EG601SN1D DCR [Ohm]
TEXT 1400 7144 Left 1 ;RS12=1m : SPI1/SPI2 deneme seri direnci (semada YOK; 33 dene) [Ohm]
TEXT 0 7208 Left 2 !.tran 0 3200n 0 20p
TEXT 0 7248 Left 2 !.options method=gear reltol=2e-3 abstol=1e-9 vntol=1e-5
TEXT 0 7288 Left 2 ;.step param KPROC list 0.75 1 1.3     <- proses taramasi: ';' yerine '!' yaz
TEXT 0 7328 Left 2 ;.step param RS12 list 1m 22 33        <- SPI1/SPI2 seri direnc taramasi
TEXT 0 7384 Left 3 ;OLCUMLER (.meas) - sonuclar Ctrl+L
TEXT 0 7448 Left 2 !.meas TRAN VDDD_MIN MIN V(VDDD,VSSD) FROM 50n TO 3200n\n.meas TRAN VSSD_PP PP V(VSSD) FROM 50n TO 3200n\n.meas TRAN V3V3_PP PP V(V3V3) FROM 50n TO 3200n\n.meas TRAN VSD_PP PP V(V3V3_SD) FROM 50n TO 3200n\n.meas TRAN S1_SCK_D_MAX MAX V(S1_SCK_D)\n.meas TRAN S1_SCK_D_MIN MIN V(S1_SCK_D)\n.meas TRAN S1_MOSI_D_MAX MAX V(S1_MOSI_D)\n.meas TRAN S1_MOSI_D_MIN MIN V(S1_MOSI_D)\n.meas TRAN S1_CS_D_MAX MAX V(S1_CS_D)\n.meas TRAN S1_CS_D_MIN MIN V(S1_CS_D)\n.meas TRAN S1_MISO_M_MAX MAX V(S1_MISO_M)\n.meas TRAN S1_MISO_M_MIN MIN V(S1_MISO_M)\n.meas TRAN S1_MISO_B00_EXP1 FIND V(S1_MISO_M) AT=195.2n\n.meas TRAN S1_MISO_B01_EXP1 FIND V(S1_MISO_M) AT=290.5n\n.meas TRAN S1_MISO_B02_EXP1 FIND V(S1_MISO_M) AT=385.7n\n.meas TRAN S1_MISO_B03_EXP1 FIND V(S1_MISO_M) AT=481n\n.meas TRAN S1_MISO_B04_EXP1 FIND V(S1_MISO_M) AT=576.2n\n.meas TRAN S1_MISO_B05_EXP1 FIND V(S1_MISO_M) AT=671.4n\n.meas TRAN S1_MISO_B06_EXP1 FIND V(S1_MISO_M) AT=766.7n\n.meas TRAN S1_MISO_B07_EXP1 FIND V(S1_MISO_M) AT=861.9n\n.meas TRAN S1_MISO_B08_EXP0 FIND V(S1_MISO_M) AT=957.1n\n.meas TRAN S1_MISO_B09_EXP0 FIND V(S1_MISO_M) AT=1052n\n.meas TRAN S1_MISO_B10_EXP0 FIND V(S1_MISO_M) AT=1148n\n.meas TRAN S1_MISO_B11_EXP0 FIND V(S1_MISO_M) AT=1243n\n.meas TRAN S1_MISO_B12_EXP0 FIND V(S1_MISO_M) AT=1338n\n.meas TRAN S1_MISO_B13_EXP0 FIND V(S1_MISO_M) AT=1433n\n.meas TRAN S1_MISO_B14_EXP0 FIND V(S1_MISO_M) AT=1529n\n.meas TRAN S1_MISO_B15_EXP0 FIND V(S1_MISO_M) AT=1624n\n.meas TRAN S1_MISO_B16_EXP0 FIND V(S1_MISO_M) AT=1719n\n.meas TRAN S1_MISO_B17_EXP0 FIND V(S1_MISO_M) AT=1814n\n.meas TRAN S1_MISO_B18_EXP1 FIND V(S1_MISO_M) AT=1910n\n.meas TRAN S1_MISO_B19_EXP0 FIND V(S1_MISO_M) AT=2005n\n.meas TRAN S1_MISO_B20_EXP0 FIND V(S1_MISO_M) AT=2100n\n.meas TRAN S1_MISO_B21_EXP1 FIND V(S1_MISO_M) AT=2195n\n.meas TRAN S1_MISO_B22_EXP0 FIND V(S1_MISO_M) AT=2290n\n.meas TRAN S1_MISO_B23_EXP0 FIND V(S1_MISO_M) AT=2386n\n.meas TRAN S2_SCK_D_MAX MAX V(S2_SCK_D)\n.meas TRAN S2_SCK_D_MIN MIN V(S2_SCK_D)\n.meas TRAN S2_MOSI_D_MAX MAX V(S2_MOSI_D)\n.meas TRAN S2_MOSI_D_MIN MIN V(S2_MOSI_D)\n.meas TRAN S2_CS_D_MAX MAX V(S2_CS_D)\n.meas TRAN S2_CS_D_MIN MIN V(S2_CS_D)\n.meas TRAN S2_MISO_M_MAX MAX V(S2_MISO_M)\n.meas TRAN S2_MISO_M_MIN MIN V(S2_MISO_M)\n.meas TRAN S2_MISO_B00_EXP1 FIND V(S2_MISO_M) AT=225.2n\n.meas TRAN S2_MISO_B01_EXP1 FIND V(S2_MISO_M) AT=320.5n\n.meas TRAN S2_MISO_B02_EXP1 FIND V(S2_MISO_M) AT=415.7n\n.meas TRAN S2_MISO_B03_EXP1 FIND V(S2_MISO_M) AT=511n\n.meas TRAN S2_MISO_B04_EXP1 FIND V(S2_MISO_M) AT=606.2n\n.meas TRAN S2_MISO_B05_EXP1 FIND V(S2_MISO_M) AT=701.4n\n.meas TRAN S2_MISO_B06_EXP1 FIND V(S2_MISO_M) AT=796.7n\n.meas TRAN S2_MISO_B07_EXP1 FIND V(S2_MISO_M) AT=891.9n\n.meas TRAN S2_MISO_B08_EXP1 FIND V(S2_MISO_M) AT=987.1n\n.meas TRAN S2_MISO_B09_EXP0 FIND V(S2_MISO_M) AT=1082n\n.meas TRAN S2_MISO_B10_EXP1 FIND V(S2_MISO_M) AT=1178n\n.meas TRAN S2_MISO_B11_EXP0 FIND V(S2_MISO_M) AT=1273n\n.meas TRAN S2_MISO_B12_EXP0 FIND V(S2_MISO_M) AT=1368n\n.meas TRAN S2_MISO_B13_EXP1 FIND V(S2_MISO_M) AT=1463n\n.meas TRAN S2_MISO_B14_EXP0 FIND V(S2_MISO_M) AT=1559n\n.meas TRAN S2_MISO_B15_EXP1 FIND V(S2_MISO_M) AT=1654n\n.meas TRAN S3_SCK_D_MAX MAX V(S3_SCK_D)\n.meas TRAN S3_SCK_D_MIN MIN V(S3_SCK_D)\n.meas TRAN S3_MOSI_D_MAX MAX V(S3_MOSI_D)\n.meas TRAN S3_MOSI_D_MIN MIN V(S3_MOSI_D)\n.meas TRAN S3_CS_D_MAX MAX V(S3_CS_D)\n.meas TRAN S3_CS_D_MIN MIN V(S3_CS_D)\n.meas TRAN S3_MISO_M_MAX MAX V(S3_MISO_M)\n.meas TRAN S3_MISO_M_MIN MIN V(S3_MISO_M)\n.meas TRAN S3_MISO_B00_EXP1 FIND V(S3_MISO_M) AT=183.8n\n.meas TRAN S3_MISO_B01_EXP1 FIND V(S3_MISO_M) AT=231.4n\n.meas TRAN S3_MISO_B02_EXP1 FIND V(S3_MISO_M) AT=279n\n.meas TRAN S3_MISO_B03_EXP1 FIND V(S3_MISO_M) AT=326.7n\n.meas TRAN S3_MISO_B04_EXP1 FIND V(S3_MISO_M) AT=374.3n\n.meas TRAN S3_MISO_B05_EXP1 FIND V(S3_MISO_M) AT=421.9n\n.meas TRAN S3_MISO_B06_EXP1 FIND V(S3_MISO_M) AT=469.5n\n.meas TRAN S3_MISO_B07_EXP1 FIND V(S3_MISO_M) AT=517.1n\n.meas TRAN S3_MISO_B08_EXP1 FIND V(S3_MISO_M) AT=564.8n\n.meas TRAN S3_MISO_B09_EXP1 FIND V(S3_MISO_M) AT=612.4n\n.meas TRAN S3_MISO_B10_EXP1 FIND V(S3_MISO_M) AT=660n\n.meas TRAN S3_MISO_B11_EXP1 FIND V(S3_MISO_M) AT=707.6n\n.meas TRAN S3_MISO_B12_EXP1 FIND V(S3_MISO_M) AT=755.2n\n.meas TRAN S3_MISO_B13_EXP1 FIND V(S3_MISO_M) AT=802.9n\n.meas TRAN S3_MISO_B14_EXP1 FIND V(S3_MISO_M) AT=850.5n\n.meas TRAN S3_MISO_B15_EXP1 FIND V(S3_MISO_M) AT=898.1n\n.meas TRAN S3_MISO_B16_EXP1 FIND V(S3_MISO_M) AT=945.7n\n.meas TRAN S3_MISO_B17_EXP1 FIND V(S3_MISO_M) AT=993.3n\n.meas TRAN S3_MISO_B18_EXP1 FIND V(S3_MISO_M) AT=1041n\n.meas TRAN S3_MISO_B19_EXP1 FIND V(S3_MISO_M) AT=1089n\n.meas TRAN S3_MISO_B20_EXP1 FIND V(S3_MISO_M) AT=1136n\n.meas TRAN S3_MISO_B21_EXP1 FIND V(S3_MISO_M) AT=1184n\n.meas TRAN S3_MISO_B22_EXP1 FIND V(S3_MISO_M) AT=1231n\n.meas TRAN S3_MISO_B23_EXP0 FIND V(S3_MISO_M) AT=1279n\n.meas TRAN S3_MISO_B24_EXP0 FIND V(S3_MISO_M) AT=1327n\n.meas TRAN S3_MISO_B25_EXP1 FIND V(S3_MISO_M) AT=1374n\n.meas TRAN S3_MISO_B26_EXP0 FIND V(S3_MISO_M) AT=1422n\n.meas TRAN S3_MISO_B27_EXP1 FIND V(S3_MISO_M) AT=1470n\n.meas TRAN S3_MISO_B28_EXP1 FIND V(S3_MISO_M) AT=1517n\n.meas TRAN S3_MISO_B29_EXP0 FIND V(S3_MISO_M) AT=1565n\n.meas TRAN S3_MISO_B30_EXP1 FIND V(S3_MISO_M) AT=1612n\n.meas TRAN S3_MISO_B31_EXP0 FIND V(S3_MISO_M) AT=1660n
TEXT 0 10680 Left 3 ;MODEL KUTUPHANESI (gomulu)
TEXT 0 10744 Left 2 !*======================================================================\n* KAPGAN FCU - GUC AGI MODEL KUTUPHANESI (LTspice'a gomulu)\n*======================================================================\n* Ortak global parametre: TAMB (ortam sicakligi, C). Tum termal\n* modeller ve diyot/LED/MOSFET instance sicakliklari TAMB'a baglidir.\n*\n* --- LD39150DT33 : 1.5A ULDO, BiCMOS, DPAK ---------------------------\n* Datasheet (ST DocID13159): Vdrop 200mV@1.5A / 40mV@300mA (typ),\n* 400mV max (-40..125C); Iq 1mA typ, 2.5mA max; Isc 3A;\n* line reg 0.04% (VO+1..6V); load reg 0.06%/A typ; SVR 65dB@120Hz;\n* TSD 170C, histerezis 10C; Rth j-c 8C/W.\n* Model: termal Foster agi (Tj dugumu), Tj'ye bagli Ron/Vref/Ilim/Iq,\n* PI hata yukselteci + anti-windup, gecis elemani kutbu, UVLO, soft-start,\n* termal kapanma (histerezisli), PMOS govde diyotu (OUT->IN ters akim).\n.subckt LD39150_33 IN OUT GND params: VNOM=3.3 RON25=0.133 ISC=3.0 IQ0=1m\n+ RJC=8 CJC=0.03 RCA=50 CCA=1.2 TSD=170 TSDH=10 UVLO=2.25 TSS=150u\n+ GM=30 FI=3k GDC=505 FP=1Meg KLINE=2.35e-4 TC1=20u TC2=-0.6u\n* -- termal (V(tj) = jonksiyon sicakligi, C)\nBamb amb 0 V={TAMB}\nRjc tj tc {RJC}\nCjc tj tc {CJC}\nRca tc amb {RCA}\nCca tc amb {CCA}\nBpd 0 tj I=max(V(IN,OUT),0)*V(ip)+max(V(IN,GND),0)*V(ig)\n* -- termal kapanma (histerezisli Schmitt)\nBtsd ts0 0 V=0.5*(1+tanh((V(tj)-({TSD}-{TSDH}*V(tsd)))/0.5))\nRts ts0 tsd 1k\nCts tsd 0 1n\n* -- UVLO (100mV histerezis) ve etkinlestirme\nBen en0 0 V=0.5*(1+tanh((V(IN,GND)-({UVLO}-0.1*V(en)))/0.02))*(1-V(tsd))\nRen en0 en 1k\nCen en 0 1n\n* -- referans: sicaklik egrisi + hat regulasyonu + soft-start\nBvt vt 0 V={VNOM}*(1+{TC1}*(V(tj)-25)+{TC2}*(V(tj)-25)*(V(tj)-25))*(1+{KLINE}*(V(IN,GND)-4.3))*V(en)+V(GND)\nRss vt vr 1k\nCss vr 0 {TSS/1k}\n* -- PI hata yukselteci (A/V), anti-windup, sizinti -> sonlu DC kazanc (yuk reg.)\nBerr err 0 V=V(vr)-V(OUT)\nBint 0 vi I=1u*({GM}*6.2832*{FI}*V(err)-1e6*(V(raw)-V(isat))-V(vi)*6.2832*{FI}/({GDC}/{GM}-1)-(1-V(en))*1e6*V(vi))\nCint vi 0 1u\nBraw raw 0 V={GM}*V(err)+V(vi)\nBsat isat 0 V=max(min(V(raw),{ISC}*(1-0.002*(V(tj)-25))),0)*V(en)\nRgp isat ig1 1k\nCgp ig1 0 {1/(6.2832*FP*1k)}\n* -- gecis elemani: dropout bolgesinde Ron(Tj), regulasyonda akim kaynagi\nBip 0 ip I=(0.5*(V(IN,OUT)+sqrt(V(IN,OUT)*V(IN,OUT)+1e-6)))/({RON25}*(1+0.004*(V(tj)-25)))*tanh(max(V(ig1),0)*{RON25}*(1+0.004*(V(tj)-25))/(0.5*(V(IN,OUT)+sqrt(V(IN,OUT)*V(IN,OUT)+1e-6))+1m))\nRip ip 0 1\nCip ip 0 1n\nBpass IN OUT I=V(ip)\nDbody OUT IN DBODY_LD\n.model DBODY_LD D(IS=1e-11 N=1.1 RS=0.05 CJO=200p)\n* -- toprak (quiescent) akimi: Iq(Tj) + dropout'ta artis\nBig ig 0 V=1u+V(en)*({IQ0}*(1+0.003*(V(tj)-25))+0.8m*0.5*(1+tanh((0.05-V(IN,OUT)+V(ip)*{RON25})/0.02)))\nBgnd IN GND I=V(ig)\nCini IN GND 100p\nCouti OUT GND 50p\nRbl OUT GND 2Meg\n.ends LD39150_33\n*\n* --- POLIMER PTC (elektro-termal, latching) ---------------------------\n* R(T)=R0*(1+TCR*(T-25))*(1+KJ/(1+exp(-(T-TTRIP)/2.5)))\n* I^2R isinmasi -> RTH/CTH -> T ; TTRIP civarinda 4 dekad sicrama.\n.subckt PTC_POLY A B params: R0=0.1 RTH=195 CTH=9m TTRIP=125 KJ=1e4 TCR=0.008\nBamb amb 0 V={TAMB}\nBr A B I=V(A,B)/({R0}*(1+{TCR}*(V(t)-25))*(1+{KJ}/(1+exp(-(V(t)-{TTRIP})/2.5))))\nBp 0 t I=V(A,B)*V(A,B)/({R0}*(1+{TCR}*(V(t)-25))*(1+{KJ}/(1+exp(-(V(t)-{TTRIP})/2.5))))\nRth t amb {RTH}\nCth t amb {CTH}\n.ends PTC_POLY\n* F1: 1206 1.1A-hold sinifi (MF-MSMF110 benzeri) ; F2: 2920 2A-hold sinifi\n.subckt PTC_1206_1A1 A B\nX1 A B PTC_POLY R0=0.10 RTH=195 CTH=9m\n.ends PTC_1206_1A1\n.subckt PTC_2920_2A A B\nX1 A B PTC_POLY R0=0.045 RTH=111 CTH=0.15\n.ends PTC_2920_2A\n*\n* --- SS34 Schottky (40V/3A, SMA) ELEKTRO-TERMAL -----------------------\n* Vf: ~0.31V@0.1A, 0.41V@1A, 0.50V@3A (25C); Ir: ~5uA@40V/25C,\n* ~2mA@100C; Eg=0.69 (Schottky), XTI=2; oz isinma Rth(j-a)=85C/W.\n.subckt SS34_ET A K params: IS0=5u N=1.2 RS=0.03 XTI=2 EG=0.69 BV=46 IBV=0.5m RTH=85 CTH=0.05 CJ=250p\nBamb amb 0 V={TAMB}\nRrs A ja {RS}\nBd ja K I={IS0}*exp({XTI}/{N}*ln((V(t)+273.15)/298.15)+{EG}/({N}*8.617e-5*(V(t)+273.15))*((V(t)+273.15)/298.15-1))*(exp(min(V(ja,K)/({N}*8.617e-5*(V(t)+273.15)),40))*(1+max(V(ja,K)/({N}*8.617e-5*(V(t)+273.15))-40,0))-1)-{IBV}*exp(min((-V(ja,K)-{BV})/(1.5*8.617e-5*(V(t)+273.15)),40))\nCj ja K {CJ}\nBp 0 t I=max(V(A,K)*V(A,ja)/{RS},0)\nRth t amb {RTH}\nCth t amb {CTH}\n.ends SS34_ET\n*\n* --- TVS / ESD diyotlari ---------------------------------------------\n* SMAJ6.0A: VR=6.0V, VBR 6.67..7.37V@10mA, VC=10.3V@38.8A, alpha(VBR)~5.7e-4/C\n.model SMAJ6V0A D(IS=2e-12 N=1.1 RS=0.012 BV=6.95 IBV=10m NBV=1.4 TBV1=5.7e-4 CJO=3.2n VJ=0.8 M=0.4 TT=50n EG=1.11 XTI=3)\n* USBLC6-2SC6 VBUS-GND zener yolu: VBR~6.1V, sizinti <150nA@5V\n.model USBLC6_Z D(IS=1e-14 N=1.05 RS=0.5 BV=6.1 IBV=1m NBV=1.2 TBV1=6e-4 CJO=60p)\n*\n* --- LED'ler (0603, tipik egriler; tempco ~-2..-3mV/C) ---------------\n.model LED_BLUE  D(IS=1.3e-21 N=2.595 RS=8 EG=1.38 XTI=3 CJO=40p BV=5 IBV=10u)\n.model LED_GREEN D(IS=2.34e-21 N=1.769 RS=6 EG=1.36 XTI=3 CJO=30p BV=5 IBV=10u)\n.model LED_RED   D(IS=2.22e-18 N=2.012 RS=5 EG=1.14 XTI=3 CJO=30p BV=5 IBV=10u)\n.model LED_AMBER D(IS=8.43e-19 N=2.012 RS=5 EG=1.14 XTI=3 CJO=30p BV=5 IBV=10u)\n*\n* --- AO3400A N-MOSFET (30V, 28mOhm@4.5V, Vth~1.05V, Ciss~630p) -------\n.model AO3400A VDMOS(Rg=1.5 Vto=1.05 Kp=19 Lambda=0.02 Rd=8m Rs=5m Rb=12m Cgdmax=200p Cgdmin=30p Cgs=550p Cjo=110p M=0.5 Is=2e-12 N=1.1 BV=30 Ksubthres=0.1 Bex=-1.5 Vtotc=-3m mfg=AOS Vds=30 Ron=28m Qg=7n)\n*\n* --- MCU GPIO cikis kati (yuksek-taraf ~40 Ohm, yumusak gecis) --------\n.model SW_GPIO SW(Ron=40 Roff=100Meg Vt=1.65 Vh=-0.3)\n*\n* --- yuk davranis fonksiyonlari --------------------------------------\n* CMOS dijital yuk: akim ~ V (C*V*f), POR esigi altinda ~0\n.func fcmos(v,von) {max(v,0)/3.3*0.5*(1+tanh((v-von)/0.08))}\n* SMPS/PMIC girisi: sabit guc, UVLO altinda kapali\n.func fpsu(p,v,vuv) {p/max(v,3.5)*0.5*(1+tanh((v-vuv)/0.05))}\n*======================================================================\n* KAPGAN SPI SINYAL BUTUNLUGU MODELLERI (IBIS-benzeri davranissal)\n*======================================================================\n* Global: TAMB (C), KPROC (proses: 0.75 yavas / 1.0 tipik / 1.3 hizli)\n*\n* --- Cikis tamponu (push-pull, uc durumlu) ----------------------------\n* in/oe: 0..1 V lojik. Pre-driver kenari TEDGE (RC). Pull-up/pull-down\n* akimi: lineer bolgede V/RON, doyumda IS (MOSFET benzeri) ; RON ~ +0.4%/C,\n* IS ~ -0.3%/C ; gecis sirasinda ortak iletim (shoot-through) dogal olarak\n* olusur ve akim vdd'den cekilir. Kalip kapasitesi, paket R-L-C, ESD\n* kelepceleri (CLV=0: 5V-toleransli FT pin, VDD diyotu yok).\n.subckt IOBUF_OUT pad vdd gnd in oe params: RONP=30 RONN=25 ISP=50m ISN=60m\n+ TEDGE=1n CDIE=5p LPKG=4n CPKG=0.6p RPKG=0.1 CLV=1\nRin in ctl 1k\nCin ctl gnd {TEDGE/2.2/1k}\nRoe oe en 1k\nCoe en gnd {TEDGE/2.2/1k}\nBpu vdd die I=max(min(V(en),1),0)*max(min(V(ctl),1),0)*{ISP}*{KPROC}*(1-0.003*({TAMB}-25))*tanh(V(vdd,die)/({ISP}*{RONP}*(1+0.004*({TAMB}-25))))\nBpd die gnd I=max(min(V(en),1),0)*(1-max(min(V(ctl),1),0))*{ISN}*{KPROC}*(1-0.003*({TAMB}-25))*tanh(V(die,gnd)/({ISN}*{RONN}*(1+0.004*({TAMB}-25))))\nCdie die gnd {CDIE}\nRlk die gnd 3.3Meg\nDcu die xcl DESD\nRcl xcl vdd {1/(CLV+1e-9)}\nDcd gnd die DESD\nRpk die pk {RPKG}\nLpk pk pad {LPKG}\nRpkd pk pad 60\nCpk pad gnd {CPKG}\n.model DESD D(IS=1e-15 N=1.05 RS=5 CJO=0.3p)\n.ends IOBUF_OUT\n*\n* --- Giris tamponu (Schmitt alici) -------------------------------------\n* Esikler VDD'ye oransal: VIH = VIHK*VDD + VIHO , VIL = VILK*VDD + VILO.\n* dout: 0..1 V lojik cikis (gozlem icin). Sizinti ILK.\n.subckt IOBUF_IN pad vdd gnd dout params: CDIE=5p LPKG=4n CPKG=0.6p RPKG=0.1\n+ VIHK=0.7 VIHO=0 VILK=0.3 VILO=0 CLV=1 ILK=1u\nRpk pad pk {RPKG}\nLpk pk die {LPKG}\nRpkd pk die 60\nCpk pad gnd {CPKG}\nCdie die gnd {CDIE}\nGlk die gnd die gnd {ILK/3.3}\nDcu die xcl DESD\nRcl xcl vdd {1/(CLV+1e-9)}\nDcd gnd die DESD\n* Alici esigi: VIH/VIL orta noktasi (Schmitt histerezisi zamanlama analizinde\n* VIH/VIL olcutuyle ayrica degerlendirilir; geri beslemesiz -> sayisal saglam)\nBth 0 d0 I=1m*0.5*(1+tanh((V(die,gnd)-0.5*({VIHK}*V(vdd,gnd)+{VIHO}+{VILK}*V(vdd,gnd)+{VILO}))/0.05))\nRd d0 dout 100\nRd0 d0 0 1k\nCd dout 0 2p\n.model DESD D(IS=1e-15 N=1.05 RS=5 CJO=0.3p)\n.ends IOBUF_IN\n*\n* --- STM32F405RGT6 guc/cekirdek modeli (LQFP64) ------------------------\n* 4x VDD (19,32,48,64) paralel paket L/R, 2x VSS (18,63); kalip ici dekuplaj;\n* dahili 1.2V cekirdek regulatoru -> VCAP1/VCAP2 (harici 2x2.2uF);\n* cekirdek akimi 168 MHz saat kenarlarinda darbeli (ort. ICORE).\n* VDDD / VSSD: kalip besleme dugumleri (IO tamponlari buraya baglanir ->\n* SSO / toprak sicramasi (ground bounce) dogal olarak olusur).\n.subckt STM32F405_CORE VDD VSS VCAP1 VCAP2 VDDD VSSD params: ICORE=55m FCLK=168Meg\nLvdd VDD v1 1.0n\nRvdp VDD v1 20\nRvdd v1 VDDD 25m\nLvss VSSD s1 2.0n\nRvsp VSSD s1 20\nRvss s1 VSS 50m\nCsub VSSD VSS 20p\nCvdx VDDD VSS 20p\nCdd VDDD dd1 3n\nRdd dd1 VSSD 0.3\nBgm0 gr0 VSSD V=8*(1.2-V(vci,VSSD))\nRgm gr0 gr 1k\nCgm gr VSSD 80p\nBreg VDDD vci I=0.5*(0.02*ln(1+exp(V(gr,VSSD)/0.02))-0.02*ln(1+exp((V(gr,VSSD)-0.5)/0.02)))/0.5*0.5*(1+tanh((V(VDDD,VSSD)-1.75)/0.05))\nCvci vci VSSD 2n\nRvci vci VSSD 10k\nRc1 vci c1 30m\nLc1 c1 VCAP1 3n\nRc2 vci c2 30m\nLc2 c2 VCAP2 3n\nVclk clk 0 PULSE(0 1 0 0.6n 0.6n {0.05/FCLK} {1/FCLK})\nBcore vci VSSD I={ICORE}*(0.5+2*V(clk))*0.5*(1+tanh((V(vci,VSSD)-0.9)/0.05))\nBiq VDDD VSSD I=3m*max(V(VDDD,VSSD),0)/3.3\n.ends STM32F405_CORE\n*\n* --- PCB izi: 8 hucreli dagitik RLC merdiveni (R,L,C birim uzunluk basina)\n.subckt TRACE_RLC a ra b rb params: LEN=0.03 RL=2.5 LL=330n CL=132p\nR0 a m0 {RL*LEN/8}\nL0 m0 n1 {LL*LEN/8}\nC0 n1 ra {CL*LEN/8}\nR1 n1 m1 {RL*LEN/8}\nL1 m1 n2 {LL*LEN/8}\nC1 n2 ra {CL*LEN/8}\nR2 n2 m2 {RL*LEN/8}\nL2 m2 n3 {LL*LEN/8}\nC2 n3 ra {CL*LEN/8}\nR3 n3 m3 {RL*LEN/8}\nL3 m3 n4 {LL*LEN/8}\nC3 n4 ra {CL*LEN/8}\nR4 n4 m4 {RL*LEN/8}\nL4 m4 n5 {LL*LEN/8}\nC4 n5 ra {CL*LEN/8}\nR5 n5 m5 {RL*LEN/8}\nL5 m5 n6 {LL*LEN/8}\nC5 n6 ra {CL*LEN/8}\nR6 n6 m6 {RL*LEN/8}\nL6 m6 n7 {LL*LEN/8}\nC6 n7 ra {CL*LEN/8}\nR7 n7 m7 {RL*LEN/8}\nL7 m7 b {LL*LEN/8}\nC7 b ra {CL*LEN/8}\nRrr ra rb 1u\n.ends TRACE_RLC\n* --- opamp2 sembolu icin pin sirasi sarmalayicilari (In+ In- V+ V- OUT)\n.subckt DRV_STM32 in oe vdd gnd pad\nX1 pad vdd gnd in oe IOBUF_OUT RONP=30 RONN=25 ISP=50m ISN=60m TEDGE=1.2n CDIE=5p LPKG=4n CPKG=0.6p RPKG=0.1\n.ends DRV_STM32\n.subckt RX_STM32 pad nc vdd gnd dout\nX1 pad vdd gnd dout IOBUF_IN CDIE=5p LPKG=4n CPKG=0.6p RPKG=0.1 VIHK=0.45 VIHO=0.3 VILK=0.35 VILO=-0.04 CLV=0 ILK=3u\nRnc nc gnd 1G\n.ends RX_STM32\n.subckt DRV_BMI270 in oe vdd gnd pad\nX1 pad vdd gnd in oe IOBUF_OUT RONP=45 RONN=45 ISP=20m ISN=20m TEDGE=2n CDIE=3p LPKG=0.6n CPKG=0.2p RPKG=0.1\n.ends DRV_BMI270\n.subckt RX_BMI270 pad nc vdd gnd dout\nX1 pad vdd gnd dout IOBUF_IN CDIE=5p LPKG=0.6n CPKG=0.2p RPKG=0.1 VIHK=0.7 VILK=0.3 ILK=1u\nRnc nc gnd 1G\n.ends RX_BMI270\n.subckt TL_S1 a ra b rb\nX1 a ra b rb TRACE_RLC LEN={LEN1} RL={ZR} LL={ZL} CL={ZC}\n.ends TL_S1\n.subckt DRV_MPU6500 in oe vdd gnd pad\nX1 pad vdd gnd in oe IOBUF_OUT RONP=50 RONN=50 ISP=15m ISN=15m TEDGE=2n CDIE=4p LPKG=0.8n CPKG=0.2p RPKG=0.1\n.ends DRV_MPU6500\n.subckt RX_MPU6500 pad nc vdd gnd dout\nX1 pad vdd gnd dout IOBUF_IN CDIE=5p LPKG=0.8n CPKG=0.2p RPKG=0.1 VIHK=0.7 VILK=0.3 ILK=1u\nRnc nc gnd 1G\n.ends RX_MPU6500\n.subckt TL_S2 a ra b rb\nX1 a ra b rb TRACE_RLC LEN={LEN2} RL={ZR} LL={ZL} CL={ZC}\n.ends TL_S2\n.subckt DRV_SD in oe vdd gnd pad\nX1 pad vdd gnd in oe IOBUF_OUT RONP=35 RONN=35 ISP=25m ISN=25m TEDGE=1.5n CDIE=6p LPKG=3n CPKG=1p RPKG=0.2\n.ends DRV_SD\n.subckt RX_SD pad nc vdd gnd dout\nX1 pad vdd gnd dout IOBUF_IN CDIE=7p LPKG=3n CPKG=1p RPKG=0.2 VIHK=0.625 VILK=0.25 ILK=10u\nRnc nc gnd 1G\n.ends RX_SD\n.subckt TL_S3 a ra b rb\nX1 a ra b rb TRACE_RLC LEN={LEN3} RL={ZR} LL={ZL} CL={ZC}\n.ends TL_S3
RECTANGLE Normal 0 0 4200 728 2
RECTANGLE Normal 624 1016 944 1272 2
